<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 백업 규칙: 즐겨찾기·명상 기록(DB)과 설정(DataStore)을 백업해 기기 변경 시 복원한다. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
